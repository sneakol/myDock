<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyDock.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PanelBackground" Color="#FAFAFB" />
          <SolidColorBrush x:Key="PanelBorder" Color="#24000000" />
          <SolidColorBrush x:Key="Divider" Color="#12000000" />
          <SolidColorBrush x:Key="TextPrimary" Color="#1C1C1E" />
          <SolidColorBrush x:Key="TextSecondary" Color="#6B6F76" />
          <SolidColorBrush x:Key="Track" Color="#16000000" />
          <SolidColorBrush x:Key="Hover" Color="#12000000" />
          <SolidColorBrush x:Key="Accent" Color="#1D7FD6" />
          <SolidColorBrush x:Key="AccentFill" Color="#2E1D7FD6" />
          <SolidColorBrush x:Key="Danger" Color="#D93F45" />
          <SolidColorBrush x:Key="BannerBackground" Color="#14D93F45" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PanelBackground" Color="#232327" />
          <SolidColorBrush x:Key="PanelBorder" Color="#30FFFFFF" />
          <SolidColorBrush x:Key="Divider" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F3" />
          <SolidColorBrush x:Key="TextSecondary" Color="#A0A4AB" />
          <SolidColorBrush x:Key="Track" Color="#1FFFFFFF" />
          <SolidColorBrush x:Key="Hover" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="Accent" Color="#4AA8FF" />
          <SolidColorBrush x:Key="AccentFill" Color="#334AA8FF" />
          <SolidColorBrush x:Key="Danger" Color="#FF6369" />
          <SolidColorBrush x:Key="BannerBackground" Color="#24FF6369" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <StreamGeometry x:Key="IconPlay">M8,5 L8,19 L19,12 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPause">M6,5 L10,5 L10,19 L6,19 Z M14,5 L18,5 L18,19 L14,19 Z</StreamGeometry>
      <StreamGeometry x:Key="IconKill">M7,2 L7,13 L10,13 L10,22 L17,10 L13,10 L17,2 Z</StreamGeometry>
      <StreamGeometry x:Key="IconMore">M12,8 C13.1,8 14,7.1 14,6 C14,4.9 13.1,4 12,4 C10.9,4 10,4.9 10,6 C10,7.1 10.9,8 12,8 Z M12,10 C10.9,10 10,10.9 10,12 C10,13.1 10.9,14 12,14 C13.1,14 14,13.1 14,12 C14,10.9 13.1,10 12,10 Z M12,16 C10.9,16 10,16.9 10,18 C10,19.1 10.9,20 12,20 C13.1,20 14,19.1 14,18 C14,16.9 13.1,16 12,16 Z</StreamGeometry>
